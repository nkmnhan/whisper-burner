# Model cache — keep subdirectory placeholder, ignore actual model files
/models/**
!/models/fast-whisper/
!/models/fast-whisper/.gitkeep

# Video source files
/videos/*.wmv
/videos/*.avi
/videos/*.mov
/videos/*.mp4
/videos/*.mkv
/videos/*.webm
/videos/*.ts
/videos/*.m2ts
/videos/*.3gp
/videos/*.flac
/videos/*.mp3
/videos/*.wav
/videos/*.m4a
/videos/*.ogg

# Generated outputs
/videos/output/
/videos/*.srt

# Docker file-mount stubs (Docker Desktop on Windows creates these on the host)
/videos/*.py

# Keep videos folder in Git
!/videos/.gitkeep

# .NET / C# build outputs
bin/
obj/
publish/

# NuGet
packages/
*.nupkg
*.snupkg

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.rsuser

# Rider
.idea/

# Vendored build tool DLLs (checked-in only as a workaround; prefer NuGet restore)
src/WhisperBurner.WinUI/.tools/AppxPackage/*.dll

# Windows App SDK / MSIX packaging
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.msixupload
*.appxupload
*.cer
release/
