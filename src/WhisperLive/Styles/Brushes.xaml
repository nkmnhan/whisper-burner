<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="CaptionOverlayBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CaptionOverlayDarkOverlayBrush" Color="#4D0A0A0A" />
            <SolidColorBrush x:Key="StatusDotReadyBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusDotCautionBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBackgroundBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBorderBrush" Color="#4DB6AC" />
            <SolidColorBrush x:Key="CaptionOverlayTextForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="AssistantUserBubbleBrush" Color="#E0E7FF" />
            <SolidColorBrush x:Key="AssistantResponseBubbleBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AssistantErrorBubbleBrush" Color="#FDE7E9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="CaptionOverlayBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CaptionOverlayDarkOverlayBrush" Color="#4D0A0A0A" />
            <SolidColorBrush x:Key="StatusDotReadyBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusDotCautionBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBackgroundBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBorderBrush" Color="#4DB6AC" />
            <SolidColorBrush x:Key="CaptionOverlayTextForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="AssistantUserBubbleBrush" Color="#3A3F5C" />
            <SolidColorBrush x:Key="AssistantResponseBubbleBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="AssistantErrorBubbleBrush" Color="#442726" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RecordingActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CaptionOverlayDarkOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="StatusDotReadyBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusDotErrorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusDotCautionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CaptionOverlayBadgeBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionOverlayTextForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AssistantUserBubbleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AssistantResponseBubbleBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AssistantErrorBubbleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Transparent background, no border — inherits all hover/pressed visual states from the default template.
        Padding="8,5": 16 px icon + 16 px H padding = 32 px minimum touch target (Fluent spec).
        Use with helpers:GhostButton (not plain Button) so the Arrow cursor is enforced even inside
        text containers like TextBox.Header that would otherwise bleed in the I-beam cursor.
    -->
    <Style x:Key="GhostButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!--
        Inline action button (Copy, Save) rendered beside chat bubbles.
        Based on GhostButtonStyle so hover/pressed states and arrow cursor are inherited.
        Compact Padding="8,4" is on the 4px grid and acceptable for supplementary inline actions.
        Use with components:GhostButton (not plain Button) to enforce arrow cursor inside the
        text-containing chat ListView.
    -->
    <Style x:Key="InlineActionButtonStyle" BasedOn="{StaticResource GhostButtonStyle}" TargetType="Button">
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!--
        Suggestion chip — quick-prompt buttons above the chat input.
        Based on SubtleButtonStyle (Gallery-recommended for low-emphasis actions).
        CornerRadius="8" (2×4px grid) gives a legible pill shape without a custom geometry.
        FontSize="12" matches CaptionTextBlockStyle for chip-scale labels.
    -->
    <Style x:Key="SuggestionChipButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
