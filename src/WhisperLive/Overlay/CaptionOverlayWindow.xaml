<Window
    x:Class="WhisperLive.Overlay.CaptionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhisperLive.Overlay"
    Title="WhisperLive Caption">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CaptionOverlayBackgroundBrush}"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY"
        ManipulationStarted="OnManipulationStarted">
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Drag handle -->
        <Border
            Grid.Row="0"
            Width="32"
            Height="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="2"
            Opacity="0.3" />

        <!-- Caption lines -->
        <ItemsControl
            Grid.Row="1"
            Margin="16,4,16,12"
            ItemsSource="{x:Bind Lines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CaptionLine">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
