<Window
    x:Class="WhisperLive.Overlay.CaptionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhisperLive.Overlay"
    Title="WhisperLive Caption">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CaptionOverlayBackgroundBrush}"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY"
        ManipulationStarted="OnManipulationStarted"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <!-- Dark overlay on top of acrylic — forces dark appearance in any system theme -->
        <Rectangle Fill="{ThemeResource CaptionOverlayDarkOverlayBrush}" />

        <Grid Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Row 0: header — label (default) or top-bar (on hover) -->
            <TextBlock
                x:Name="LiveTranscriptLabel"
                Grid.Row="0"
                VerticalAlignment="Center"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Live Transcript" />

            <Grid
                x:Name="TopBar"
                Grid.Row="0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Language badge -->
                <Border
                    Grid.Column="0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="#4DB6AC"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="LanguageLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="White"
                            Text="English" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="White"
                            Glyph="&#xE70D;"
                            Opacity="0.7" />
                    </StackPanel>
                </Border>

                <!-- Close button -->
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClicked"
                    CornerRadius="0"
                    Foreground="White"
                    ToolTipService.ToolTip="Hide overlay">
                    <SymbolIcon Symbol="Cancel" />
                </Button>

                <!-- Pause / Resume button -->
                <Button
                    x:Name="OverlayPauseButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnOverlayPauseClicked"
                    CornerRadius="0"
                    Foreground="White"
                    ToolTipService.ToolTip="Pause / Resume">
                    <FontIcon x:Name="OverlayPauseIcon" FontSize="14" Glyph="&#xE769;" />
                </Button>
            </Grid>

            <!-- Row 1: scrollable caption lines -->
            <ScrollViewer
                x:Name="CaptionScroller"
                Grid.Row="1"
                Margin="0,4,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{x:Bind DisplayLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:CaptionLine">
                            <TextBlock
                                FontSize="18"
                                Foreground="White"
                                LineHeight="28"
                                Text="{x:Bind Text, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Row 2: expand / collapse chevron -->
            <Button
                Grid.Row="2"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnExpandClicked"
                CornerRadius="16"
                Foreground="White"
                ToolTipService.ToolTip="Expand / Collapse">
                <FontIcon x:Name="ChevronIcon" FontSize="12" Glyph="&#xE70E;" />
            </Button>
        </Grid>
    </Grid>
</Window>
