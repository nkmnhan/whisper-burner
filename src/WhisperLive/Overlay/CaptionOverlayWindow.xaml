<Window
    x:Class="WhisperLive.Overlay.CaptionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhisperLive.Overlay"
    Title="WhisperLive Caption">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CaptionOverlayBackgroundBrush}"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY"
        ManipulationStarted="OnManipulationStarted"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <!-- Main content: always visible -->
        <Grid Margin="16,8,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="LiveTranscriptLabel"
                Grid.Row="0"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Live Transcript" />

            <ItemsControl
                Grid.Row="1"
                Margin="0,4,0,0"
                ItemsSource="{x:Bind DisplayLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CaptionLine">
                        <TextBlock
                            FontSize="18"
                            Foreground="White"
                            Text="{x:Bind Text, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom expand/collapse chevron -->
            <Button
                Grid.Row="2"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnExpandClicked"
                CornerRadius="16"
                Foreground="White"
                ToolTipService.ToolTip="Expand / Collapse">
                <FontIcon x:Name="ChevronIcon" FontSize="12" Glyph="&#xE70E;" />
            </Button>
        </Grid>

        <!-- Top bar overlay: hidden by default, revealed on hover -->
        <Grid
            x:Name="TopBar"
            Height="32"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Language badge: teal outline, transparent fill -->
            <Border
                Grid.Column="0"
                Margin="12,0,0,0"
                Padding="8,3"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="#4DB6AC"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        x:Name="LanguageLabel"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="White"
                        Text="English" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="White"
                        Glyph="&#xE70D;"
                        Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Expand + Close buttons -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnExpandClicked"
                    CornerRadius="0"
                    Foreground="White"
                    ToolTipService.ToolTip="Expand / Collapse">
                    <FontIcon x:Name="TopBarExpandIcon" FontSize="14" Glyph="&#xE8A7;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClicked"
                    CornerRadius="0"
                    Foreground="White"
                    ToolTipService.ToolTip="Close">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
