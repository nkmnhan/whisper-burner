<Window
    x:Class="WhisperLive.Overlay.CaptionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhisperLive Caption">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CaptionOverlayBackgroundBrush}"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY"
        ManipulationStarted="OnManipulationStarted"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <!-- Dark overlay on top of acrylic — forces dark appearance in any system theme -->
        <Rectangle AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource CaptionOverlayDarkOverlayBrush}" />

        <Grid Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Row 0: header — label (default) or top-bar (on hover) -->
            <TextBlock
                x:Name="LiveTranscriptLabel"
                Grid.Row="0"
                VerticalAlignment="Center"
                FontSize="13"
                FontStyle="Italic"
                FontWeight="SemiBold"
                Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                Text="Live Transcript" />

            <Grid
                x:Name="TopBar"
                Grid.Row="0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Language badge -->
                <Border
                    Grid.Column="0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CaptionOverlayBadgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="LanguageLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                            Text="English" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                            Glyph="&#xE70D;"
                            Opacity="0.7" />
                    </StackPanel>
                </Border>

                <!-- Close button -->
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Hide overlay"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.ToolTip="Hide overlay">
                    <SymbolIcon Symbol="Cancel" />
                </Button>

                <!-- Pause / Resume button -->
                <Button
                    x:Name="OverlayPauseButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Pause or resume"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnOverlayPauseClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.ToolTip="Pause / Resume">
                    <FontIcon x:Name="OverlayPauseIcon" FontSize="14" Glyph="&#xE769;" />
                </Button>
            </Grid>

            <!-- Row 1: scrollable caption area — original text + latest translation -->
            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Original text (full scrollable history) -->
                <ScrollViewer
                    x:Name="CaptionScroller"
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <TextBlock
                        x:Name="CaptionText"
                        FontSize="15"
                        Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                        LineHeight="24"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- Latest translated segment — full brightness, larger -->
                <TextBlock
                    x:Name="TranslatedCaptionText"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    LineHeight="30"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <!-- Row 2: expand / collapse chevron -->
            <Button
                Grid.Row="2"
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Expand or collapse overlay"
                Background="Transparent"
                BorderThickness="0"
                Click="OnExpandClicked"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                ToolTipService.ToolTip="Expand / Collapse">
                <FontIcon x:Name="ChevronIcon" FontSize="12" Glyph="&#xE70E;" />
            </Button>
        </Grid>
    </Grid>
</Window>
