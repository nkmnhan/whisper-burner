<Window
    x:Class="WhisperLive.Components.CaptionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WhisperLive.Models"
    Title="WhisperLive Caption">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource CaptionOverlayBackgroundBrush}"
        ManipulationDelta="OnManipulationDelta"
        ManipulationMode="TranslateX,TranslateY"
        ManipulationStarted="OnManipulationStarted"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <!-- Dark overlay on top of acrylic — forces dark appearance in any system theme -->
        <Rectangle AutomationProperties.AccessibilityView="Raw" Fill="{ThemeResource CaptionOverlayDarkOverlayBrush}" />

        <!--
            ContentRoot: 2 rows (header + captions). No dedicated chevron row.
            Margin: 12 all sides. Padding: 8px top gives the header row clearance from
            ContentRoot's top edge so button hover highlights are never clipped.
            VerticalAlignment="Bottom": content hugs the bottom edge; ResizeToContent shrinks
            the window to fit so there is never dead space above the captions.
        -->
        <Grid
            x:Name="ContentRoot"
            Margin="12,12,12,12"
            Padding="0,8,0,0"
            VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Row 0 — HeaderBar (default, always visible):
                "Live Transcript" label + expand/collapse chevron on the right.
                Chevron is discoverable at rest and doesn't require hovering.
                E70D = ChevronDown (collapsed → expand), E70E = ChevronUp (expanded → collapse).
            -->
            <Grid x:Name="HeaderBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LiveTranscriptLabel"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontStyle="Italic"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Live Transcript" />
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="Expand or collapse overlay"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnExpandClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.ToolTip="Expand / Collapse">
                    <FontIcon x:Name="ChevronIcon" FontSize="11" Glyph="&#xE70D;" />
                </Button>
            </Grid>

            <!--
                Row 0 — TopBar (hover only, replaces HeaderBar):
                Lang chips | spacer | expand | pause | close.
                All buttons 28×28 — matches the 28px row height with no overflow.
            -->
            <Grid
                x:Name="TopBar"
                Grid.Row="0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Language badges: source chip + optional arrow + translation target chip -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock
                            x:Name="LanguageLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                            Text="auto" />
                    </Border>
                    <TextBlock
                        x:Name="LangArrow"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                        Opacity="0.6"
                        Text="→"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="TranslationTargetChip"
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TranslationTargetLabel"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}" />
                    </Border>
                </StackPanel>

                <!-- Expand / Collapse (mirrors HeaderBar chevron) -->
                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="Expand or collapse overlay"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnExpandClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="Expand / Collapse">
                    <FontIcon x:Name="TopBarChevronIcon" FontSize="11" Glyph="&#xE70D;" />
                </Button>

                <!-- Pause / Resume -->
                <Button
                    x:Name="OverlayPauseButton"
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="Pause or resume"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnOverlayPauseClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="Pause / Resume">
                    <FontIcon x:Name="OverlayPauseIcon" FontSize="12" Glyph="&#xE769;" />
                </Button>

                <!-- Close -->
                <Button
                    Grid.Column="4"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="Hide overlay"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClicked"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                    ToolTipService.Placement="Bottom"
                    ToolTipService.ToolTip="Hide overlay">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!-- Row 1: transcript list — capped slice bound via _overlayRows -->
            <ListView
                x:Name="CaptionsPanel"
                Grid.Row="1"
                Margin="0,4,0,0"
                VerticalAlignment="Bottom"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TranslatedSegmentView">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="{x:Bind OriginalFontSize, Mode=OneWay}"
                                FontStyle="{x:Bind OriginalFontStyle, Mode=OneWay}"
                                Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                                Opacity="{x:Bind OriginalOpacity, Mode=OneWay}"
                                Text="{x:Bind OriginalText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CaptionOverlayTextForegroundBrush}"
                                Text="{x:Bind TranslatedText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind TranslatedVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
