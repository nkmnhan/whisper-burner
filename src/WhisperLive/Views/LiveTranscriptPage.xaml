<Page
    x:Class="WhisperLive.Views.LiveTranscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <!-- Waveform storyboard — 5 bars staggered by 80 ms each -->
        <Storyboard x:Name="WaveformStoryboard">
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar1Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.080"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar2Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.160"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar3Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.240"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar4Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.320"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar5Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
        </Storyboard>

        <!-- Recording dot pulse -->
        <Storyboard x:Name="DotPulseStoryboard">
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.45"
                RepeatBehavior="Forever"
                Storyboard.TargetName="StatusDotScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="1.5" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.45"
                RepeatBehavior="Forever"
                Storyboard.TargetName="StatusDotScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.0" To="1.5" />
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Status bar — dot + label only -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal" Spacing="8">
            <Ellipse
                x:Name="StatusDot"
                Width="8"
                Height="8"
                VerticalAlignment="Center"
                Fill="{ThemeResource SystemFillColorCautionBrush}">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="StatusDotScale" CenterX="4" CenterY="4" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock
                x:Name="StatusLabel"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Checking API…" />
        </StackPanel>

        <!-- Row 1: idle placeholder OR live transcript -->
        <StackPanel
            x:Name="IdlePlaceholder"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                x:Name="MicIcon"
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE720;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Capture system audio as live transcript" />
        </StackPanel>

        <ListView
            x:Name="TranscriptList"
            Grid.Row="1"
            SelectionMode="None"
            Visibility="Collapsed">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0,3,0,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        FontSize="14"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Row 2: actions -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">

                <!-- New session: idle only, when prior transcript exists -->
                <Button
                    x:Name="NewSessionButton"
                    Width="48"
                    Height="48"
                    Click="OnNewSessionClicked"
                    ToolTipService.ToolTip="New session — clears transcript and starts a new file"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                </Button>

                <!-- Main button: Start (idle) → waveform animation inside (recording) → click to stop -->
                <Button
                    x:Name="MainButton"
                    Width="200"
                    Height="48"
                    Click="OnMainButtonClicked"
                    Style="{StaticResource AccentButtonStyle}">
                    <Grid>
                        <StackPanel x:Name="StartContent" Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE720;" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                        <StackPanel x:Name="WaveformInButton" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar1Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar2Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar3Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar4Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="2">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar5Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Pause: visible while recording or paused -->
                <Button
                    x:Name="PauseButton"
                    Width="48"
                    Height="48"
                    Click="OnPauseClicked"
                    ToolTipService.ToolTip="Pause recording"
                    Visibility="Collapsed">
                    <FontIcon x:Name="PauseIcon" FontSize="16" Glyph="&#xE769;" />
                </Button>

                <!-- Show overlay: when overlay was dismissed during recording -->
                <Button
                    x:Name="ShowOverlayButton"
                    Width="48"
                    Height="48"
                    Click="OnShowOverlayClicked"
                    ToolTipService.ToolTip="Show live transcript overlay"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE890;" />
                </Button>

            </StackPanel>

            <TextBlock
                x:Name="ActionStatus"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>
