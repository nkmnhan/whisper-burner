<Page
    x:Class="WhisperLive.Views.LiveTranscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:WhisperLive.Components"
    xmlns:helpers="using:WhisperLive.Helpers"
    xmlns:models="using:WhisperLive.Models">
    <Page.Resources>
        <!-- Assistant chat bubbles — picked by AssistantMessageTemplateSelector based on Role -->
        <DataTemplate x:Key="AssistantUserMessageTemplate" x:DataType="models:AssistantMessage">
            <Border
                Margin="40,0,0,0"
                Padding="10,6"
                HorizontalAlignment="Right"
                Background="{ThemeResource AssistantUserBubbleBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AssistantResponseMessageTemplate" x:DataType="models:AssistantMessage">
            <Border
                Margin="0,0,40,0"
                Padding="10,6"
                HorizontalAlignment="Left"
                Background="{ThemeResource AssistantResponseBubbleBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <helpers:AssistantMessageTemplateSelector
            x:Key="AssistantMessageSelector"
            ResponseTemplate="{StaticResource AssistantResponseMessageTemplate}"
            UserTemplate="{StaticResource AssistantUserMessageTemplate}" />
        <!-- Waveform storyboard — 5 bars staggered by 80 ms each -->
        <Storyboard x:Name="WaveformStoryboard">
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar1Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.080"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar2Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.160"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar3Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.240"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar4Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.320"
                Duration="0:0:0.6"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar5Scale"
                Storyboard.TargetProperty="ScaleY"
                From="0.2" To="1.0" />
        </Storyboard>

        <!-- Recording dot pulse -->
        <Storyboard x:Name="DotPulseStoryboard">
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.45"
                RepeatBehavior="Forever"
                Storyboard.TargetName="StatusDotScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="1.5" />
            <DoubleAnimation
                AutoReverse="True"
                BeginTime="0:0:0.000"
                Duration="0:0:0.45"
                RepeatBehavior="Forever"
                Storyboard.TargetName="StatusDotScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.0" To="1.5" />
        </Storyboard>

        <!--
            Thinking indicator: enter (Decelerate 150ms) — Gallery EasingFunction: use EaseOut for objects entering the scene.
            Opacity animates 0→1; Visibility is set to Visible before Begin() in code-behind.
        -->
        <Storyboard x:Name="ShowThinkingStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ThinkingIndicator"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4.5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--
            Thinking indicator: exit (Accelerate 100ms) — Gallery EasingFunction: use EaseIn for objects exiting the scene.
            Completed handler in code-behind sets Visibility=Collapsed and stops the dots storyboard.
        -->
        <Storyboard x:Name="HideThinkingStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ThinkingIndicator"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.10">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4.5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--
            Animated thinking dots — cycles "Thinking" → "Thinking." → "Thinking.." → "Thinking..."
            every 500ms, giving the VS Code AI "thinking in progress" feel without a spinner next to text.
        -->
        <Storyboard x:Name="ThinkingDotsStoryboard" RepeatBehavior="Forever">
            <ObjectAnimationUsingKeyFrames
                Storyboard.TargetName="ThinkingDotsText"
                Storyboard.TargetProperty="Text">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.0" Value="Thinking" />
                <DiscreteObjectKeyFrame KeyTime="0:0:0.5" Value="Thinking." />
                <DiscreteObjectKeyFrame KeyTime="0:0:1.0" Value="Thinking.." />
                <DiscreteObjectKeyFrame KeyTime="0:0:1.5" Value="Thinking..." />
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Assistant panel: slide in from the right (EaseOut 250ms) -->
        <Storyboard x:Name="PanelShowStoryboard">
            <DoubleAnimation
                From="32" To="0"
                Duration="0:0:0.25"
                Storyboard.TargetName="AssistantPanelTranslate"
                Storyboard.TargetProperty="X">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                From="0" To="1"
                Duration="0:0:0.2"
                Storyboard.TargetName="AssistantPanel"
                Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Assistant panel: fade out (EaseIn 150ms) — Completed handler collapses Visibility -->
        <Storyboard x:Name="PanelHideStoryboard">
            <DoubleAnimation
                From="1" To="0"
                Duration="0:0:0.15"
                Storyboard.TargetName="AssistantPanel"
                Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseIn" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ActionStatus fade-in (EaseOut 200ms) -->
        <Storyboard x:Name="StatusFadeInStoryboard">
            <DoubleAnimation
                From="0" To="1"
                Duration="0:0:0.2"
                Storyboard.TargetName="ActionStatus"
                Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut" Exponent="4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Status bar — dot + label, assistant toggle, API error InfoBar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Fill="{ThemeResource SystemFillColorCautionBrush}">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="StatusDotScale" CenterX="4" CenterY="4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock
                        x:Name="StatusLabel"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Checking API…" />
                </StackPanel>
                <!--
                    ToggleButton: IsChecked=True → panel visible (Checked fires ShowAssistantPanel),
                    IsChecked=False → panel animates out (Unchecked fires HideAssistantPanel).
                    InfoBadge: AttentionDotInfoBadgeStyle — shown when notes refresh while panel is
                    closed. AutomationProperties.Name updated to include "new notes" when badge visible
                    so screen readers announce the state change.
                    Gallery pattern: PlacingInfobadgeInsideAnother.txt — inner Grid stretch, badge TopRight.
                -->
                <ToggleButton
                    x:Name="AssistantToggleButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Assistant"
                    Checked="OnAssistantToggleChecked"
                    HorizontalContentAlignment="Stretch"
                    ToolTipService.ToolTip="Meeting assistant — notes and Q&amp;A"
                    Unchecked="OnAssistantToggleUnchecked"
                    VerticalContentAlignment="Stretch">
                    <Grid
                        Width="Auto"
                        Height="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <StackPanel
                            Margin="4,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                            <TextBlock Text="Assistant" />
                        </StackPanel>
                        <InfoBadge
                            x:Name="AssistantBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource AttentionDotInfoBadgeStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                </ToggleButton>
            </Grid>
            <!--
                InfoBar: Error severity — shown only when Whisper API health check fails.
                IsClosable=True lets user dismiss once they've read it; code re-opens it if API
                is still down on next health check. Severity=Error gives the red icon + color
                that matches the status dot already shown.
            -->
            <InfoBar
                x:Name="ApiErrorBar"
                IsClosable="True"
                IsOpen="False"
                Message="Start the Whisper Docker container, then check the API URL in Settings."
                Severity="Error"
                Title="Whisper API offline" />
        </StackPanel>

        <!-- Row 1: live transcript (always visible) + collapsible assistant panel -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="IdlePlaceholder"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon
                    x:Name="MicIcon"
                    HorizontalAlignment="Center"
                    FontSize="56"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE720;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Capture system audio as live transcript" />
                <TextBox
                    x:Name="PreContextBox"
                    MaxWidth="400"
                    MaxHeight="120"
                    Margin="0,8,0,0"
                    AcceptsReturn="True"
                    PlaceholderText="Agenda, participants, background — Claude reads this before the meeting starts"
                    TextWrapping="Wrap">
                    <TextBox.Header>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="Meeting context (optional)" />
                            <components:GhostButton
                                x:Name="ContextHistoryButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="Recent &amp; saved prompts"
                                Click="OnContextHistoryClicked">
                                <FontIcon FontSize="16" Glyph="&#xE81C;" />
                            </components:GhostButton>
                            <components:GhostButton
                                x:Name="SaveContextButton"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="Save as preset"
                                Click="OnSaveContextClicked">
                                <FontIcon FontSize="16" Glyph="&#xE718;" />
                            </components:GhostButton>
                        </StackPanel>
                    </TextBox.Header>
                </TextBox>
            </StackPanel>

            <ListView
                x:Name="TranscriptList"
                Grid.Column="0"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0,4,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="14"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Assistant panel: Notes (auto-generated outline) / Ask (live Q&A chat) -->
            <Border
                x:Name="AssistantPanel"
                Grid.Column="1"
                Grid.RowSpan="2"
                Width="320"
                Margin="16,0,0,0"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="Collapsed">
                <!--
                    TranslateTransform is the target for PanelShowStoryboard (X: 32→0, EaseOut 250ms)
                    and PanelHideStoryboard (Opacity: 1→0, EaseIn 150ms). Visibility is set to
                    Collapsed in PanelHideStoryboard.Completed in code-behind.
                -->
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AssistantPanelTranslate" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        SelectorBar: Gallery-recommended tab switcher (Navigation group).
                        Gives keyboard navigation, selection state, and the underline indicator
                        for free — replaces the manual AccentButtonStyle toggling on two Buttons.
                        IsSelected="True" on first item sets the initial selection in XAML
                        so no code-behind initialization is needed (Gallery SelectorBarPage pattern).
                    -->
                    <SelectorBar
                        x:Name="PanelTabBar"
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        SelectionChanged="OnPanelTabSelectionChanged">
                        <SelectorBarItem x:Name="NotesTabItem" IsSelected="True" Text="Notes" />
                        <SelectorBarItem x:Name="AskTabItem" Text="Ask" />
                    </SelectorBar>

                    <!-- Notes view: scrolling chat-bubble snapshots, UI only (not saved to disk) -->
                    <Grid x:Name="NotesView" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Bubble list -->
                        <ListView
                            x:Name="NotesChatList"
                            Grid.Row="0"
                            SelectionMode="None">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <!--
                                AddDeleteThemeTransition: matches AssistantChatList — notes
                                snapshots slide in with a fade when added, consistent with the
                                chat list. Gallery pattern: Collections > ListView.
                            -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0,4,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:NotesBubble">
                                    <Border
                                        Margin="0,0,8,0"
                                        Padding="10,8"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AssistantResponseBubbleBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind TimeLabel}" />
                                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty / waiting state -->
                        <StackPanel
                            x:Name="NotesEmptyPanel"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <ProgressRing
                                x:Name="NotesWaitingRing"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Generating notes"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="NotesEmptyLabel"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Notes appear here — updated every 3 minutes"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="NotesCountdownLabel"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="NotesUpdatedLabel"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <ProgressRing
                                x:Name="NotesRefreshRing"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Refreshing notes"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <components:GhostButton
                                x:Name="RefreshNotesButton"
                                IsEnabled="False"
                                AutomationProperties.Name="Refresh notes now"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="Refresh notes now"
                                Click="OnRefreshNotesClicked">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </components:GhostButton>
                            <components:GhostButton
                                x:Name="ExpandNotesButton"
                                IsEnabled="False"
                                AutomationProperties.Name="View full notes"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="View full notes"
                                Click="OnExpandNotesClicked">
                                <FontIcon FontSize="16" Glyph="&#xE740;" />
                            </components:GhostButton>
                        </StackPanel>
                    </Grid>

                    <!-- Chat view: freeform "what did I miss" Q&A -->
                    <Grid x:Name="ChatView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="AssistantChatList"
                            Grid.Row="0"
                            ItemTemplateSelector="{StaticResource AssistantMessageSelector}"
                            SelectionMode="None">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel VerticalAlignment="Bottom" ItemsUpdatingScrollMode="KeepLastItemInView" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <!--
                                AddDeleteThemeTransition: Gallery-recommended transition for ListView items
                                being added. Each new message slides in with a fade — no code-behind needed.
                            -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0,4,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <!-- Thinking indicator: shown while Claude call is in flight -->
                        <StackPanel
                            x:Name="ThinkingIndicator"
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            Opacity="0"
                            AutomationProperties.Name="Claude is thinking"
                            AutomationProperties.LiveSetting="Assertive"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                IsActive="True" />
                            <TextBlock
                                x:Name="ThinkingDotsText"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Thinking" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AssistantQuestionBox"
                                Grid.Column="0"
                                AcceptsReturn="False"
                                AutomationProperties.HelpText="Press Enter or the send button to submit"
                                KeyDown="OnAssistantQuestionKeyDown"
                                PlaceholderText="Ask about the meeting…"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="SendQuestionButton"
                                Grid.Column="1"
                                Click="OnSendQuestionClicked"
                                Style="{StaticResource AccentButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE724;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1 / Column 0: actions — inside left column so it centers with the content above -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0" HorizontalAlignment="Center" Spacing="12">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">

                <!-- New session: idle only, when prior transcript exists -->
                <Button
                    x:Name="NewSessionButton"
                    Width="48"
                    Height="48"
                    AutomationProperties.Name="New session"
                    Click="OnNewSessionClicked"
                    ToolTipService.ToolTip="New session — clears transcript and starts a new file"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                </Button>

                <!-- Main button: Start (idle) → waveform animation inside (recording) → click to stop -->
                <Button
                    x:Name="MainButton"
                    Width="200"
                    Height="48"
                    Click="OnMainButtonClicked"
                    Style="{StaticResource AccentButtonStyle}">
                    <Grid>
                        <StackPanel x:Name="StartContent" Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE720;" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                        <StackPanel x:Name="WaveformInButton" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar1Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar2Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar3Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar4Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <Border Width="3" Height="20" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.RenderTransform><ScaleTransform x:Name="Bar5Scale" CenterX="1.5" CenterY="20" ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Pause: visible while recording or paused -->
                <Button
                    x:Name="PauseButton"
                    Width="48"
                    Height="48"
                    AutomationProperties.Name="Pause recording"
                    Click="OnPauseClicked"
                    ToolTipService.ToolTip="Pause recording"
                    Visibility="Collapsed">
                    <FontIcon x:Name="PauseIcon" FontSize="16" Glyph="&#xE769;" />
                </Button>

                <!-- Show overlay: when overlay was dismissed during recording -->
                <Button
                    x:Name="ShowOverlayButton"
                    Width="48"
                    Height="48"
                    AutomationProperties.Name="Show live transcript overlay"
                    Click="OnShowOverlayClicked"
                    ToolTipService.ToolTip="Show live transcript overlay"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE890;" />
                </Button>

            </StackPanel>

            <TextBlock
                x:Name="ActionStatus"
                Opacity="0"
                HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>
