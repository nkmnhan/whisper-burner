<Page
    x:Class="WhisperLive.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24,16" Spacing="4">

            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!-- Whisper API -->
            <controls:SettingsExpander
                x:Name="ApiExpander"
                Description="Connection to the local Whisper Docker API"
                Header="Whisper API"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="http://localhost:5000" Header="API URL">
                        <TextBox
                            x:Name="ApiUrlBox"
                            Width="260"
                            HorizontalAlignment="Right"
                            PlaceholderText="http://localhost:5000"
                            TextChanged="OnApiUrlChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Whisper model to use for transcription" Header="Model">
                        <ComboBox
                            x:Name="ModelBox"
                            Width="160"
                            HorizontalAlignment="Right"
                            SelectionChanged="OnModelChanged">
                            <ComboBoxItem Content="tiny" />
                            <ComboBoxItem Content="base" />
                            <ComboBoxItem Content="small" />
                            <ComboBoxItem Content="medium" />
                            <ComboBoxItem Content="large-v3" />
                            <ComboBoxItem Content="turbo" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Seconds of audio per transcription request (2–10)" Header="Chunk duration">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider
                                x:Name="ChunkSlider"
                                Width="160"
                                Maximum="10"
                                Minimum="2"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                ValueChanged="OnChunkDurationChanged" />
                            <TextBlock
                                x:Name="ChunkLabel"
                                Width="28"
                                VerticalAlignment="Center"
                                Text="5 s" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Language -->
            <controls:SettingsCard Description="Language spoken in the audio" Header="Language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LanguageBox"
                    Width="160"
                    HorizontalAlignment="Right"
                    SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="auto" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="vi" />
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="zh" />
                    <ComboBoxItem Content="fr" />
                    <ComboBoxItem Content="de" />
                    <ComboBoxItem Content="es" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- Meeting assistant -->
            <controls:SettingsCard Description="Optional folder (code repo or documents) the meeting assistant can read for extra context" Header="Meeting context folder">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="ContextFolderLabel"
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Not set"
                        TextTrimming="CharacterEllipsis" />
                    <Button x:Name="BrowseContextFolderButton" Click="OnBrowseContextFolderClicked" Content="Browse…" />
                    <Button x:Name="ClearContextFolderButton" Click="OnClearContextFolderClicked" Content="Clear" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Allowed read paths -->
            <controls:SettingsExpander
                x:Name="AllowedPathsExpander"
                Description="Files and folders Claude can read during a meeting session"
                Header="Allowed Read Paths"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8F4;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddFolderButton" Click="OnAddFolderClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddFileButton" Click="OnAddFileClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                <TextBlock Text="Add file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Content>
            </controls:SettingsExpander>

            <!-- Appearance -->
            <controls:SettingsCard Description="Choose app color theme" Header="Appearance">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                    <ComboBoxItem Content="Use system setting" Tag="Default" />
                </ComboBox>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
