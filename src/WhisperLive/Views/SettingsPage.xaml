<Page
    x:Class="WhisperLive.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24,16" Spacing="4">

            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!-- Whisper API -->
            <controls:SettingsExpander
                x:Name="ApiExpander"
                Description="Connection to the local Whisper Docker API"
                Header="Whisper API"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Description="http://localhost:5000" Header="API URL">
                        <TextBox
                            x:Name="ApiUrlBox"
                            Width="260"
                            HorizontalAlignment="Right"
                            PlaceholderText="http://localhost:5000"
                            TextChanged="OnApiUrlChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Whisper model to use for transcription" Header="Model">
                        <ComboBox
                            x:Name="ModelBox"
                            Width="160"
                            HorizontalAlignment="Right"
                            SelectionChanged="OnModelChanged">
                            <ComboBoxItem Content="tiny" />
                            <ComboBoxItem Content="base" />
                            <ComboBoxItem Content="small" />
                            <ComboBoxItem Content="medium" />
                            <ComboBoxItem Content="large-v3" />
                            <ComboBoxItem Content="turbo" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="Seconds of audio per transcription request (2–10)" Header="Chunk duration">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider
                                x:Name="ChunkSlider"
                                Width="160"
                                Maximum="10"
                                Minimum="2"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                ValueChanged="OnChunkDurationChanged" />
                            <TextBlock
                                x:Name="ChunkLabel"
                                Width="28"
                                VerticalAlignment="Center"
                                Text="5 s" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Language -->
            <controls:SettingsCard Description="Language spoken in the audio" Header="Language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LanguageBox"
                    Width="160"
                    HorizontalAlignment="Right"
                    SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="auto" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="vi" />
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="zh" />
                    <ComboBoxItem Content="fr" />
                    <ComboBoxItem Content="de" />
                    <ComboBoxItem Content="es" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- Appearance -->
            <controls:SettingsExpander
                Description="Choose app color theme"
                Header="Appearance"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="App theme">
                        <RadioButtons x:Name="ThemeRadio" SelectionChanged="OnThemeChanged">
                            <RadioButton Content="System default" Tag="Default" />
                            <RadioButton Content="Light" Tag="Light" />
                            <RadioButton Content="Dark" Tag="Dark" />
                        </RadioButtons>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
