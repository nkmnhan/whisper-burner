<Window
    x:Class="WhisperBurner.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WhisperBurner.WinUI"
    Title="Whisper Burner">
    <Grid>
        <Pivot x:Name="MainPivot" SelectionChanged="MainPivot_SelectionChanged">
            <PivotItem x:Name="RecordingTab" Header="Record">
                <Frame x:Name="RecordingFrame" />
            </PivotItem>
            <PivotItem x:Name="SessionsTab" Header="Sessions">
                <Frame x:Name="SessionsFrame" />
            </PivotItem>
            <PivotItem x:Name="SettingsTab" Header="Settings">
                <Frame x:Name="SettingsFrame" />
            </PivotItem>
        </Pivot>
    </Grid>
</Window>
