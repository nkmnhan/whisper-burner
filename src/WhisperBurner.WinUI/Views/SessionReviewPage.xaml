<Page
    x:Class="WhisperBurner.WinUI.Views.SessionReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sessions"
                   Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <InfoBar Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Coming soon"
                 Message="Session review — replay recordings and preview subtitles — will be available in a future update. Your sessions are already being saved to %USERPROFILE%\whisper.burner\sessions\" />
    </Grid>
</Page>
