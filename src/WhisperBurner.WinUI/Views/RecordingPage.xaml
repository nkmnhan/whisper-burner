<Page
    x:Class="WhisperBurner.WinUI.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WhisperBurner.WinUI.Models"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="CtrlR_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Storyboard x:Key="WaveformStoryboard">
            <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1.0" Duration="0:0:0.6" AutoReverse="True"
                             RepeatBehavior="Forever" BeginTime="0:0:0" />
            <DoubleAnimation Storyboard.TargetName="Bar2Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1.0" Duration="0:0:0.6" AutoReverse="True"
                             RepeatBehavior="Forever" BeginTime="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="Bar3Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1.0" Duration="0:0:0.6" AutoReverse="True"
                             RepeatBehavior="Forever" BeginTime="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="Bar4Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1.0" Duration="0:0:0.6" AutoReverse="True"
                             RepeatBehavior="Forever" BeginTime="0:0:0.24" />
            <DoubleAnimation Storyboard.TargetName="Bar5Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.25" To="1.0" Duration="0:0:0.6" AutoReverse="True"
                             RepeatBehavior="Forever" BeginTime="0:0:0.32" />
        </Storyboard>
        <Storyboard x:Key="PulseDotStoryboard">
            <DoubleAnimation Storyboard.TargetName="ApiDotScale" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.5" Duration="0:0:0.9" AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ApiDotScale" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.5" Duration="0:0:0.9" AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Page.Resources>

    <Grid Padding="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zone 1: Status bar -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse x:Name="ApiDot" Width="8" Height="8" Fill="Gray"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="ApiDotScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock x:Name="ApiStatusLabel" Text="Checking…" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ModelLabel" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Zone 2: Mic / waveform + live transcript -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mic icon / waveform -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon x:Name="MicIcon" Glyph="&#xE720;"
                          FontFamily="Segoe Fluent Icons" FontSize="72"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <StackPanel x:Name="WaveformPanel" Orientation="Horizontal" Spacing="5"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Style="{StaticResource WaveformBarStyle}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                    <Border Style="{StaticResource WaveformBarStyle}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                    <Border Style="{StaticResource WaveformBarStyle}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                    <Border Style="{StaticResource WaveformBarStyle}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform x:Name="Bar4Scale" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                    <Border Style="{StaticResource WaveformBarStyle}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform x:Name="Bar5Scale" ScaleY="0.25" /></Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Live transcript panel (visible only while recording) -->
            <Border Grid.Row="1" x:Name="LiveTranscriptPanel" Visibility="Collapsed"
                    Background="#14FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,12,0,0">
                <ScrollViewer x:Name="TranscriptScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="150">
                    <ItemsRepeater x:Name="TranscriptRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:SubtitleSegment">
                                <TextBlock Text="{x:Bind Text}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,2"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Zone 3: Buttons + status -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8">
            <Button x:Name="StartButton" Click="StartButton_Click" IsEnabled="False"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE720;" FontSize="14" />
                    <TextBlock Text="Start Recording" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Click="StopButton_Click" Visibility="Collapsed"
                    HorizontalAlignment="Center" Style="{StaticResource StopButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Text="Waiting for API…" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
        </StackPanel>

        <!-- Zone 4: Session-saved banner -->
        <Border Grid.Row="3" x:Name="SavedBanner" Visibility="Collapsed"
                Background="#CC1D4427" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8FB;" FontFamily="Segoe Fluent Icons"
                              FontSize="14" Foreground="#90EE90" />
                    <TextBlock x:Name="SavedBannerText" FontSize="12" Foreground="White"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open Folder" FontSize="11"
                        Padding="10,4" Margin="8,0" Click="OpenFolderBtn_Click" />
                <Button Grid.Column="2" Content="✕" FontSize="11" Padding="6,4"
                        Click="DismissBanner_Click" />
            </Grid>
        </Border>

    </Grid>
</Page>
