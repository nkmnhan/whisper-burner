<Window
    x:Class="WhisperBurner.WinUI.Overlay.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Subtitles">

    <Grid x:Name="RootGrid">
        <Border x:Name="CaptionBox"
                Background="#E8191919"
                CornerRadius="8"
                BorderThickness="0">
            <Grid>

                <!-- Caption text — fills entire box -->
                <ScrollViewer x:Name="Scroller"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,44,20,16">
                    <ItemsRepeater x:Name="LinesRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           FontSize="{Binding FontSize}"
                                           FontFamily="Segoe UI Variable Display"
                                           Foreground="White"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           LineHeight="36"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- TOP controls — overlaid, hidden until mouse enters -->
                <Grid x:Name="TopControls"
                      VerticalAlignment="Top" Height="36"
                      Background="Transparent" Opacity="0">

                    <!-- Status badge (left) -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="12,0"
                            BorderBrush="#446699FF" BorderThickness="1"
                            CornerRadius="10" Padding="8,2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="RecordingDot"
                                     Width="7" Height="7" Fill="#FF4444"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="RecordingIndicator"
                                       Text="Live Caption"
                                       FontSize="11" Foreground="#88AAFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- A- / A+ / ✕ (right) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" Spacing="0">
                        <Button x:Name="FontSmallBtn" Content="A−"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,4" FontSize="12"
                                Foreground="#AAFFFFFF"
                                Click="FontSmallBtn_Click" />
                        <Button x:Name="FontLargeBtn" Content="A+"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,4" FontSize="12"
                                Foreground="#AAFFFFFF"
                                Click="FontLargeBtn_Click" />
                        <Button x:Name="CloseBtn" Content="✕"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4" FontSize="13"
                                Foreground="#CCFFFFFF"
                                Click="StopBtn_Click" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
