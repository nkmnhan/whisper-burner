<Window
    x:Class="WhisperBurner.WinUI.Overlay.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WhisperBurner.WinUI.Models"
    Title="Subtitles">
    <Grid Background="Transparent">

        <!-- Drag handle — InputNonClientPointerSource registers this region as caption -->
        <Border
            x:Name="DragHandle"
            Height="22"
            VerticalAlignment="Top"
            Background="#22FFFFFF">
            <TextBlock Text="⠿ drag to move"
                       FontSize="10" Foreground="#55FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Border>

        <!-- Recording indicator — bottom-left -->
        <TextBlock x:Name="RecordingIndicator"
                   Text="● Listening…"
                   FontSize="10"
                   Foreground="#80FF8080"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="8,0,0,4"
                   IsHitTestVisible="False" />

        <!-- Control buttons — top-right -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,2,8,0"
                    Spacing="4">
            <Button x:Name="FreezeBtn"
                    Content="❚❚ Pause"
                    Padding="10,2"
                    FontSize="11"
                    Click="FreezeBtn_Click" />
            <Button x:Name="StopBtn"
                    Content="■ Stop"
                    Padding="10,2"
                    FontSize="11"
                    Click="StopBtn_Click" />
        </StackPanel>

        <!-- Rolling subtitle history — 10-line ring buffer -->
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="16,26,16,20">
            <ItemsRepeater x:Name="LinesRepeater">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SubtitleSegment">
                        <TextBlock Text="{x:Bind Text}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,2" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

    </Grid>
</Window>
