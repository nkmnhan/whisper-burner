<Window
    x:Class="WhisperBurner.WinUI.Overlay.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Subtitles">
    <Grid Background="Transparent">

        <!-- Drag handle — InputNonClientPointerSource registers this region as caption;
             Windows handles drag natively without P/Invoke -->
        <Border
            x:Name="DragHandle"
            Height="22"
            VerticalAlignment="Top"
            Background="#22FFFFFF">
            <TextBlock Text="⠿ drag to move"
                       FontSize="10" Foreground="#55FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Border>

        <!-- Recording indicator — bottom-left -->
        <TextBlock x:Name="RecordingIndicator"
                   Text="● Listening…"
                   FontSize="10"
                   Foreground="#80FF8080"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="8,0,0,4"
                   IsHitTestVisible="False" />

        <!-- Stop button — top-right -->
        <Button
            x:Name="StopBtn"
            Content="■ Stop"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,2,8,0"
            Padding="10,2"
            FontSize="11"
            Click="StopBtn_Click" />

        <!-- Subtitle text -->
        <TextBlock
            x:Name="SubtitleText"
            Foreground="White"
            FontSize="22"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            TextAlignment="Center"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="16,26,90,20"
            MaxLines="3" />
    </Grid>
</Window>
